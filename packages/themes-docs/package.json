{
  "name": "@theholocron/themes-docs",
  "version": "1.3.3",
  "description": "Documentation content for the @theholocron/docs-theme Starlight plugin and content loader",
  "keywords": [
    "docs",
    "documentation",
    "content",
    "starlight",
    "astro",
    "docs-theme"
  ],
  "homepage": "https://github.com/theholocron/themes/tree/main/packages/themes-docs#readme",
  "bugs": "https://github.com/theholocron/themes/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/themes.git",
    "directory": "packages/themes-docs"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "content",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@theholocron/tsconfig": "catalog:",
    "@theholocron/tsdown-config": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "releases": "https://github.com/theholocron/themes/releases",
  "wiki": "https://github.com/theholocron/themes/wiki"
}

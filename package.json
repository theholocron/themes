{
  "name": "@theholocron/themes",
  "version": "1.10.4",
  "private": true,
  "description": "Themes and design tokens.",
  "homepage": "https://docs.theholocron.dev/themes/",
  "bugs": "https://github.com/theholocron/themes/issues",
  "repository": "github:theholocron/themes",
  "license": "GPL-3.0",
  "author": "Newton Koumantzelis",
  "type": "module",
  "scripts": {
    "build": "turbo run delivery.build",
    "delivery.build": "holocron run delivery.build --",
    "docs:build": "astro build",
    "docs:dev": "astro dev",
    "docs:preview": "astro preview",
    "format": "prettier --write .",
    "holocron": "holocron",
    "knowledge.wiki": "holocron run knowledge.wiki --",
    "platform.commitStandards": "holocron run platform.commitStandards --",
    "platform.repoSync": "holocron run platform.repoSync --",
    "prepare": "husky",
    "security.secretDetection": "holocron run security.secretDetection --",
    "sourceQuality.deadCodeAnalysis": "holocron run sourceQuality.deadCodeAnalysis --",
    "sourceQuality.formatting": "holocron run sourceQuality.formatting --",
    "sourceQuality.staticAnalysis": "holocron run sourceQuality.staticAnalysis --",
    "sourceQuality.structuredDataValidation": "holocron run sourceQuality.structuredDataValidation --",
    "verification.typeSafety": "holocron run verification.typeSafety --",
    "verification.unitTests": "holocron run verification.unitTests --"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/starlight": "^0.41.7",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@theholocron/astro-config": "catalog:",
    "@theholocron/astromech": "catalog:holocron",
    "@theholocron/cli": "catalog:holocron",
    "@theholocron/commitlint-config": "catalog:",
    "@theholocron/components-doc": "catalog:docs",
    "@theholocron/docs-theme": "workspace:*",
    "@theholocron/eslint-config": "catalog:",
    "@theholocron/holocron-plugin-cloudflare": "catalog:holocron",
    "@theholocron/holocron-plugin-fern": "catalog:holocron",
    "@theholocron/holocron-plugin-github": "catalog:holocron",
    "@theholocron/lint-staged-config": "catalog:",
    "@theholocron/prettier-config": "catalog:",
    "@theholocron/registry-doc": "catalog:docs",
    "@theholocron/semantic-release-config": "catalog:",
    "@theholocron/skills": "catalog:",
    "@theholocron/stylelint-config": "catalog:",
    "@theholocron/tsconfig": "catalog:",
    "alexjs": "^1.0.0",
    "astro": "^7.2.2",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^16.2.6",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semantic-release": "^25.0.9",
    "sort-package-json": "^4.0.0",
    "starlight-typedoc": "^0.23.1",
    "stylelint": "^17.14.1",
    "turbo": "^2.10.10",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@commitlint/config-conventional": "^21.2.2",
      "@commitlint/config-conventional>conventional-changelog-conventionalcommits": "7",
      "conventional-changelog-conventionalcommits": "9.3.1",
      "tsx": "4.22.4"
    }
  },
  "releases": "https://github.com/theholocron/themes/releases",
  "wiki": "https://github.com/theholocron/themes/wiki"
}
